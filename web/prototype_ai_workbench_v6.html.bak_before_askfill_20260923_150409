  h += '<div class="rel-sec">快捷操作</div>'
    + '<div class="kv"><i>🧩 在管理中打开</i><b class="act" style="cursor:pointer" onclick="openInManagerNid(\''+esc(String(n.id))+'\',\''+esc(n.nsType||"")+'\')">去编辑 →</b></div>';
