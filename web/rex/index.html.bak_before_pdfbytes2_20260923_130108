/* ===== 阅读板块融合改造（File Agent）：宿主工作台内嵌模式 ===== */
html.rex-embed .topbar,html.rex-embed #sidebar,html.rex-embed #ai,
html.rex-embed #settings,html.rex-embed #drop-overlay{display:none!important}
html.rex-embed #app{height:100vh}
html.rex-embed .body{min-height:0}
html.rex-embed .viewer{flex:1 1 auto;height:100%}
html.rex-embed .host{padding:20px 16px 96px}
html.rex-embed .empty-title{font-size:20px}
/* 锚点：就地浮在被划词文字正上方；hover 时高亮正文对应区域 */
.anchor-dot{position:absolute;transform:translate(-50%,-100%);width:9px;height:9px}
.anchor-hl{position:absolute;z-index:7;display:none;pointer-events:none;border-radius:3px;
  background:rgba(112,72,232,.26);box-shadow:0 0 0 1px rgba(112,72,232,.45) inset}
.anchor-dot{transform:translate(-50%,-100%);margin-top:-4px}
.anchor-dot:hover{background:var(--accent-2);box-shadow:0 0 0 3px color-mix(in srgb,var(--accent) 32%,transparent),0 2px 8px #66087499}
html.rex-embed .float-ask{z-index:900}
</style>
  </head>
  <body>
    <div id="app">
      <!-- 顶栏 -->
      <header class="topbar">
        <div class="tb-left">
          <span class="brand">ReX</span>
          <span class="sub">当你看世界，世界也在看你</span>
        </div>
        <div class="tb-ctrl">
          <button id="btn-open" class="btn primary">打开</button>
          <span class="sep"></span>
          <button id="btn-zoomout" class="btn" title="缩小">−</button>
          <span id="zoom-label" class="zoom">100%</span>
          <button id="btn-zoomin" class="btn" title="放大">+</button>
          <button id="btn-fit" class="btn">适合宽度</button>
          <span class="sep"></span>
          <input id="page-input" class="pg" type="number" min="1" value="1" title="页码" />
          <span id="page-total" class="pg-label">/ 0</span>
        </div>
        <div class="tb-right">
          <span id="model-chip" class="chip" title="点击配置模型">未配置模型</span>
          <button id="btn-settings" class="btn" title="模型设置">模型</button>
        </div>
      </header>

      <div class="body">
        <!-- 左：文档栏 -->
        <aside id="sidebar" class="sidebar">
          <div class="side-head">
            <span>文档</span>
            <button id="btn-coll-side" class="icon-btn" title="收起">«</button>
          </div>
          <ul id="doc-list" class="doc-list"></ul>
          <div class="side-empty" id="side-empty">还没有打开文档</div>
        </aside>

        <!-- 中：阅读区 -->
        <main id="viewer" class="viewer">
          <div id="empty" class="empty">
            <div class="empty-title">欢迎使用 ReX</div>
            <div class="empty-sub">
              拖拽文档到此处，或
              <button id="btn-open-empty" class="link-btn">点击打开</button>
            </div>
          </div>
          <div id="host" class="host"></div>
        </main>

        <!-- 右：AI 问答 -->
        <aside id="ai" class="ai">
          <div class="ai-head">
            <span>AI 对话</span>
            <button id="btn-coll-ai" class="icon-btn" title="收起">»</button>
          </div>
          <div id="ai-messages" class="ai-msgs"></div>
          <div class="ai-input">
            <textarea id="ai-text" rows="2" placeholder="就当前文档提问，或先在文中划词选中后提问"></textarea>
            <button id="btn-ask" class="btn primary">发送</button>
          </div>
          <button id="btn-newchat" class="btn ghost block">新建对话</button>
        </aside>
      </div>
    </div>

    <input id="file-input" type="file" multiple hidden />
    <div id="drop-overlay" class="drop-overlay" hidden><div class="drop-box">松开鼠标以打开</div></div>

    <!-- 划词提问 / 锚点：全局取词）
    <div id="float-ask" class="float-ask" hidden><button id="btn-ask-sel" class="btn primary">划词提问</button></div>
    -->

    <!-- 模型设置 -->
    <div id="settings" class="modal-mask" hidden>
      <div class="modal">
        <div class="modal-title">模型设置（OpenAI 兼容接口）</div>
        <label>接口 Base URL
          <input id="set-base" type="text" placeholder="https://ark.cn-beijing.volces.com/api/v3" />
        </label>
        <label>API Key
          <input id="set-key" type="password" placeholder="sk-..." />
        </label>
        <label>模型名
          <input id="set-model" type="text" placeholder="deepseek-v4-flash" />
        </label>
        <div class="modal-actions">
          <button id="btn-save-model" class="btn primary">保存</button>
          <button id="btn-cancel-model" class="btn">取消</button>
        </div>
        <div id="model-msg" class="modal-msg"></div>
      </div>
    </div>

  </body>
</html>