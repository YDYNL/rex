<http://edu-scholar.org/ontology#Paper:pc.23761.pdf> a es:Paper ;
    es:aiSummary "该文献研究了sisal纤维混凝土圆柱体外部包裹jute FRP后的力学行为。通过实验分析不同包裹条件下材料的力学性能变化，结论表明jute FRP能有效提升混凝土圆柱体的抗压和抗弯性能。"^^xsd:string ;
    es:autoKeywords "sisal fiber concrete, jute frp, mechanical behavior, composite materials, structural performance"^^xsd:string ;
    es:confidence 0.7 ;
    es:doi "10.1002/pc.23761"^^xsd:string ;
    es:hasAuthor <http://edu-scholar.org/ontology#Author:Hang_Li>,
        <http://edu-scholar.org/ontology#Author:Haozhi_Tan>,
        <http://edu-scholar.org/ontology#Author:Jia_yi_Chen>,
        <http://edu-scholar.org/ontology#Author:Liang_Huang>,
        <http://edu-scholar.org/ontology#Author:Libo_Yan>,
        <http://edu-scholar.org/ontology#Author:Ying_Wang> ;
    es:hasKeyword <http://edu-scholar.org/ontology#Keyword:concrete>,
        <http://edu-scholar.org/ontology#Keyword:cylinders>,
        <http://edu-scholar.org/ontology#Keyword:externally>,
        <http://edu-scholar.org/ontology#Keyword:fiber>,
        <http://edu-scholar.org/ontology#Keyword:jute>,
        <http://edu-scholar.org/ontology#Keyword:sisal>,
        <http://edu-scholar.org/ontology#Keyword:wrapped> ;
    es:paperType "期刊论文" ;
    es:publishedIn <http://edu-scholar.org/ontology#Venue:Polymer_Composites> ;
    es:related_to <http://edu-scholar.org/ontology#LocalFile:pc.23761.pdf> ;
    es:sourcedFrom <http://edu-scholar.org/ontology#LocalFile:pc.23761.pdf> ;
    es:title "Behavior of Sisal Fiber Concrete Cylinders Externally Wrapped With Jute FRP"^^xsd:string ;
    es:year "2017"^^xsd:gYear .

