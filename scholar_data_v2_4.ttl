    es:sourcedFrom <http://edu-scholar.org/ontology#LocalFile:_CFRP___.pdf> ;
    es:title "不同锚固方案下CFRP板增强混凝土板梁力学性能研究"^^xsd:string ;
    es:year "2021"^^xsd:gYear .

