        <http://edu-scholar.org/ontology#Keyword:fiber-reinforced_polymer>,
        <http://edu-scholar.org/ontology#Keyword:shear_tests> ;
    es:paperType "期刊论文" ;
    es:publishedIn <http://edu-scholar.org/ontology#Venue:journal_homepage_www.elsevier.com_locate_compstruct> ;
    es:related_to <http://edu-scholar.org/ontology#LocalFile:Effect_of_engineered_cementitious_composite_on_the_bond_behavior_between_fiber-reinforced_polymer_and_concrete.pdf> ;
