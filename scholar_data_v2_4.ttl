    es:related_to <http://edu-scholar.org/ontology#LocalFile:___.pdf> ;
    es:sourcedFrom <http://edu-scholar.org/ontology#LocalFile:___.pdf> ;
    es:title "钢筋混凝土连续梁在集中荷载下的挠度计算"^^xsd:string .

