    es:title "Effect of engineered cementitious composite on the bond behavior between fiber-reinforced polymer and concrete"^^xsd:string .

<http://edu-scholar.org/ontology#Paper:FRP___.pdf> a es:Paper ;
    es:aiSummary "该文献通过六组预应力混凝土单向板的弯曲试验，研究GFPR预应力筋的预应力水平与配筋率对结构抗裂性能及挠度的影响。测试结果表明提升预应力可显著增强开裂荷载与挠度，但会降低极限挠度，同时提出适用于预应力FRP筋的抗裂能力与刚度计算方法。"^^xsd:string ;
    es:autoKeywords "prestressed concrete, gfrp tendons, flexural behavior, crack control, stiffness calculation"^^xsd:string ;
    es:confidence 0.95 ;
    es:doi "10.15951/j.tmgcxb.2015.03.007"^^xsd:string ;
    es:hasAuthor <http://edu-scholar.org/ontology#Author:Fang_Dong>,
        <http://edu-scholar.org/ontology#Author:Gao_Danying>,
        <http://edu-scholar.org/ontology#Author:Zhu_Yubin> ;
    es:hasKeyword <http://edu-scholar.org/ontology#Keyword:crack_control>,
        <http://edu-scholar.org/ontology#Keyword:flexural_behavior>,
        <http://edu-scholar.org/ontology#Keyword:gfrp_tendons>,
        <http://edu-scholar.org/ontology#Keyword:prestressed_concrete>,
        <http://edu-scholar.org/ontology#Keyword:stiffness_calculation> ;
    es:paperType "期刊论文" ;
    es:related_to <http://edu-scholar.org/ontology#LocalFile:_FRP___.pdf> ;
    es:sourcedFrom <http://edu-scholar.org/ontology#LocalFile:_FRP___.pdf> ;
    es:title "体外预应力FRP筋加固混凝土单向板抗裂及刚度计算方法"^^xsd:string ;
    es:year "2015"^^xsd:gYear .

